# Copy this file to .env for local development and fill in real values.
# Never commit .env — it's already in .gitignore.
#
# In production, set these as real environment variables on your hosting
# platform instead of shipping a .env file.

# --- Core (required) ---
# Owner connection for migrations and operator scripts, if different from DATABASE_URL.
OWNER_DATABASE_URL=
# Only for a deployment that knowingly still runs as the table owner (see docs/OPERATIONS_RUNBOOK.md section 2).
ALLOW_OWNER_DATABASE_ROLE=

NODE_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/patient_doctor_app

# Optional: the restricted database role the running application should use (see docs/SECURITY.md,
# "Rolling out the restricted role"). When set together with DB_ENFORCE_RLS=on, the application connects
# with no ownership and no DDL, and row-level security applies. Migrations and operator scripts keep
# using DATABASE_URL (the owner). Create the role with: npm run db:create-app-role
APP_DATABASE_URL=
DB_ENFORCE_RLS=

# Secret used to sign JWT auth tokens. Generate a real random value for any
# non-local environment, e.g.: openssl rand -hex 32
# The app refuses to start in production if this isn't set, rather than
# silently falling back to an insecure default that would let anyone forge
# valid auth tokens.
JWT_SECRET=

# Public base URL of this deployment. Used to build links in emails. No
# trailing slash.
APP_URL=http://localhost:3001

# --- Email (optional in development) ---
#
# Without RESEND_API_KEY, emails are logged to the console instead of sent
# ("[MOCK EMAIL]") — the app still works fully in development.

RESEND_API_KEY=
EMAIL_FROM="Patient-Doctor App <noreply@APP_DOMAIN>"

# Comma-separated list of addresses notified when a new doctor application
# is submitted. Optional — leave unset to disable.
ADMIN_NOTIFICATION_EMAILS=

# --- Server ---

PORT=3001

# --- Second factor (required in production) ---
# 32 random bytes, base64: openssl rand -base64 32. Encrypts authenticator secrets; losing it locks clinicians, staff and
# administrators out of their second factor. Development derives a key from JWT_SECRET so nothing needs setting.
MFA_ENCRYPTION_KEY=

# --- E-mail delivery reports ---
# The signing secret of the webhook you add at the e-mail provider (POST /api/webhooks/resend). Without it Avela can say an
# e-mail was ACCEPTED but never that it was delivered or bounced.
RESEND_WEBHOOK_SECRET=

# --- Emergency numbers ---
# Numbers per country live in shared/emergency.ts with their sources. In production they are shown only after a person has
# compared them with those sources; put that person's name here to say it was done. Never set it on someone else's behalf.
EMERGENCY_DATA_REVIEWED_BY=

# Real support contact details, shown to patients. When unset, the app
# shows no support phone/email (it never shows a placeholder).
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=

# --- Reminders and scheduled jobs ---
#
# Medication reminders are delivered by calling GET /api/cron/reminders with
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron does this automatically
# once CRON_SECRET is set (daily on the free plan); .github/workflows/reminders.yml
# calls it every five minutes. Without CRON_SECRET the endpoint does not exist
# and the app tells patients that automatic reminders are not switched on.
CRON_SECRET=

# --- Administrators ---
# There is no public way to become an administrator. Create the first one from a
# trusted shell: ADMIN_EMAIL=... ADMIN_NAME=... ADMIN_PASSWORD=... npm run admin:create

# --- Reminder scheduler (see docs/SCHEDULER.md) ---
#
# CRON_SECRET: the bearer secret the scheduler presents to /api/cron/reminders (openssl rand -hex 32).
# Without it the endpoint answers 503 and the app says automatic reminders are off.
CRON_SECRET=
# Optional: an https URL pinged after every successful run (and <url>/fail after a failed one) by an
# external dead-man's-switch monitor, so a scheduler that STOPS calling is noticed.
SCHEDULER_HEARTBEAT_URL=
# Optional: e-mailed when scheduler failures begin and when they end (needs RESEND_API_KEY).
OPS_ALERT_EMAIL=
# Optional tuning: REMINDER_LOOKBACK_MINUTES (180), REMINDER_MAX_RUN_AGE_MINUTES (20),
# SCHEDULER_BUDGET_MS (20000), SCHEDULER_LEASE_MS (90000), EMAIL_TIMEOUT_MS (8000).
