# Copy this file to .env for local development and fill in real values.
# Never commit .env — it's already in .gitignore.
#
# In production, set these as real environment variables on your hosting
# platform instead of shipping a .env file.

# --- Core (required) ---

NODE_ENV=development

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/patient_doctor_app

# Secret used to sign JWT auth tokens. Generate a real random value for any
# non-local environment, e.g.: openssl rand -hex 32
# The app refuses to start in production if this isn't set, rather than
# silently falling back to an insecure default that would let anyone forge
# valid auth tokens.
JWT_SECRET=

# Public base URL of this deployment. Used to build links in emails. No
# trailing slash.
APP_URL=http://localhost:3001

# --- Email (optional in development) ---
#
# Without RESEND_API_KEY, emails are logged to the console instead of sent
# ("[MOCK EMAIL]") — the app still works fully in development.

RESEND_API_KEY=
EMAIL_FROM="Patient-Doctor App <noreply@APP_DOMAIN>"

# Comma-separated list of addresses notified when a new doctor application
# is submitted. Optional — leave unset to disable.
ADMIN_NOTIFICATION_EMAILS=

# --- Speech-to-text (optional in development) ---
#
# Symptom voice input is transcribed server-side. Raw audio describing a
# health symptom is PHI, so this MUST go through a HIPAA-eligible provider
# under a signed BAA in production — see server/services/speechService.ts.
# The voice-transcription endpoint refuses to handle requests in
# production without this configured, rather than silently falling back
# to a non-BAA provider — other features are unaffected either way.
#
# Without it set, development uses a mock transcription with zero network
# calls (see speechService.ts) so voice input is still testable locally.

STT_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- AI Health Navigator (optional) ---
#
# Powers the in-app AI assistant (server/services/aiService.ts) — a
# healthcare information/organization assistant, not a diagnostic tool.
# Without this set, it falls back to a deterministic, still-genuinely-useful
# responder grounded in the patient's own data (no external calls). Doctor
# matching itself (matchingService.ts) is always deterministic regardless
# of this key.

OPENAI_API_KEY=

# --- Server ---

PORT=3001

# --- Honesty switches (see docs/AUDIT.md) ---
# DEMO_MODE=true enables simulated integrations (fake pharmacy courier, demo
# login buttons). Always on in local dev/test; must be set deliberately
# anywhere else. Leave unset for a real deployment.
DEMO_MODE=

# Patient data is only ever sent to OpenAI when BOTH an API key is set AND
# you confirm you have the legal basis (e.g. a signed BAA / zero-retention
# agreement) by setting this to "true".
AI_PHI_PROCESSING_CONFIRMED=

# Real support contact details, shown to patients. When unset, the app
# shows no support phone/email (it never shows a placeholder).
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=

# --- Reminders and scheduled jobs ---
#
# Medication reminders are delivered by calling GET /api/cron/reminders with
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron does this automatically
# once CRON_SECRET is set (daily on the free plan); .github/workflows/reminders.yml
# calls it every five minutes. Without CRON_SECRET the endpoint does not exist
# and the app tells patients that automatic reminders are not switched on.
CRON_SECRET=

# --- Administrators ---
# There is no public way to become an administrator. Create the first one from a
# trusted shell: ADMIN_EMAIL=... ADMIN_NAME=... ADMIN_PASSWORD=... npm run admin:create

# --- Emergency number shown on every screen (built into the client bundle) ---
# Default 911. Set the number that is right for where the service operates.
VITE_EMERGENCY_NUMBER=
